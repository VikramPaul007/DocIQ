# Dev-only image: source and node_modules are volume-mounted at runtime (see
# docker-compose.yml), so there's nothing useful to COPY/RUN at build time —
# `npm install` runs on every start instead, which also makes the (named,
# persisted) node_modules volume self-healing across dependency changes.
FROM node:20-alpine
WORKDIR /app
EXPOSE 5173
CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0 --port 5173"]
