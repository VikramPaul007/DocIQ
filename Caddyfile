{
	# Local dev: self-signed TLS via Caddy's internal CA.
	auto_https disable_redirects
}

https://{$CADDY_DOMAIN} {
	tls internal

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; connect-src 'self'"
		-Server
	}

	# Reject oversized bodies early (uploads are capped again in the API).
	request_body {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:5173
	}
}
